  <property name="styleSheet">
   <string notr="true">QMainWindow{
	background-color: rgb(45, 50, 80);
	color: rgb(255, 255, 255);
	font: 10px;
}

QWidget{
	background-color: rgb(45, 50, 80);
}

QListView{
	background-color: rgb(66, 71, 105);
	border-radius: 7px;
	color: rgb(255, 255, 255);
	font: 10px; 
}

QListView::item {
    padding: 2px;  /* Отступы вокруг текста в строке */
}

QListView::item:selected {
	background-color: rgb(249, 177, 122); /* Цвет фона строки при выделении */
	color: rgb(255, 255, 255);
}

QListView::item:hover {
    background-color: rgb(249, 177, 122);  /* Цвет фона строки при наведении */
    color: rgb(255, 255, 255);            /* Цвет текста при наведении */
}


QPushButton {
   /* background-image: url(C:/София/София/python/UI_diploma_1/icons/open-folder.png);  /* Путь к картинке */
	
	background-color: rgb(249, 177, 122);
    background-size: auto 5%;  /* Масштабируем картинку, чтобы она помещалась */
    border-radius: 5px;  /* Закругление углов */
    border: none;  /* Убираем рамку */
	width: 20px;  /* Увеличиваем размер кнопки */
    height: 20px; /* Увеличиваем размер кнопки */
}

QLineEdit{
	border-radius: 7px;
	background-color: rgb(66, 71, 105);
	color: rgb(255, 255, 255);
	font: 10px;   
}

QTabWidget {
	/*background-color:  rgb(45, 50, 80);*/
	border-radius: 7px;
	background: transparent;
}

QTabWidget::pane {
    border: 4px solid rgb(66, 71, 105);
	background-color: rgb(45, 50, 80);
	border-radius: 7px;
}

QTabBar {
	border-radius: 4px;
    background-color: rgb(45, 50, 80); /* Цвет фона для панели вкладок */
    color: white;                /* Цвет текста на вкладках */
    font: 10px;             /* Шрифт для текста на вкладках */
}

QTabBar::tab {
    background-color: rgb(45, 50, 80);  /* Цвет фона вкладки */
    color: white;                /* Цвет текста вкладки */
    padding: 2px 2px;          /* Отступы внутри вкладки */
    border-radius: 4px;          /* Закругление углов вкладки */
    transition: all 0.3s ease;   /* Плавное изменение стилей */
	border: 4px solid rgb(66, 71, 105);
}

QTabBar::tab:selected {
    background-color: rgb(66, 71, 105);  /* Цвет фона для выбранной вкладки */
    color: white;                /* Цвет текста для выбранной вкладки */
    font-weight: bold;           /* Жирный шрифт для выбранной вкладки */
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);  /* Тень для выделенной вкладки */
    transform: scale(1.1);       /* Увеличение вкладки (эффект выдвижения) */
    z-index: 1;                  /* Поднимем вкладку выше остальных */
}

QTabBar::tab:hover {
	background-color: rgb(249, 177, 122);
	color: rgb(45, 50, 80);
    border: 4px solid rgb(45, 50, 80);   /* Цвет рамки при наведении */
}

QMenuBar {
    background-color: rrgb(45, 50, 80); /* Цвет фона панели меню */
    color: white; /* Цвет текста на панели меню */
    font: 12px; /* Шрифт текста на панели меню */
    border: none; /* Убираем границу, если нужна */
}

QMenuBar::item {
    background-color:rgb(45, 50, 80); /* Цвет фона для элементов меню */
    padding: 2px;
	font: 12px;
	color: white;
}

QMenuBar::item:selected {
	background-color: rgb(66, 71, 105);
	color: white;
	font: 12px;
}

QMenu::item {
     background-color: transparent;
    color: white;
    padding: 2px 2px;
	font: 12px;
 }

QMenu::item:selected {
    background-color:  rgb(66, 71, 105);
	color: white;
	font: 12px;
}

QMenu::item:hover {
	background-color: rgb(249, 177, 122);
	color: rgb(45, 50, 80);
	font: 12px;
}

QDialog {
    font-size: 10pt;
	color: rgb(255, 255, 255);
}

QCheckBox {
	font-size: 10pt;
	color: rgb(255, 255, 255);
}

QMessageBox {
	font-size: 10pt;
	color: rgb(255, 255, 255);
}

QMessageBox QLabel {
    color: rgb(255, 255, 255); 
}

QCheckBox::indicator {
    border-radius: 10px; 
    border: 2px solid rgb(66, 71, 105); 
    background-color:rgb(45, 50, 80); 
}

QCheckBox::indicator:checked {
    background-color:  rgb(249, 177, 122); 
    border: 2px solid rgb(66, 71, 105); 
}

QCheckBox::indicator:unchecked {
    border: 2px solid rgb(66, 71, 105); 
    background-color:rgb(45, 50, 80); 
}

QCheckBox::indicator:hover {
	background-color: rgb(66, 71, 105); 
}

QLabel {
    color: rgb(255, 255, 255); 
}
</string>
